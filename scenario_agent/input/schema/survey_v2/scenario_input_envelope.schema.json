{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario input envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_version",
    "request",
    "policy",
    "target_profile",
    "survey_context",
    "evidence_quality"
  ],
  "$defs": {
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "value": {
          "title": "Value"
        },
        "status": {
          "enum": [
            "observed",
            "configured",
            "inferred",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed At"
        },
        "time_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Time Reason"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        }
      },
      "required": [
        "id",
        "domain",
        "subject",
        "predicate",
        "value",
        "status",
        "observed_at",
        "time_reason",
        "evidence_refs"
      ],
      "title": "Fact",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "reason": {
          "enum": [
            "not_checked",
            "out_of_scope",
            "tool_error",
            "truncated",
            "stale",
            "invalid_evidence",
            "missing_time",
            "insufficient_evidence"
          ],
          "title": "Reason",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "reason",
        "detail"
      ],
      "title": "Gap",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "pointer": {
          "title": "Pointer",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "file",
        "pointer",
        "sha256",
        "source"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "adapter_version": {
      "const": "scenario_survey_v2.2"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "target_id",
        "target_ip",
        "planning_scope",
        "max_steps",
        "execution_authorized",
        "cleanup_required",
        "rollback_required"
      ],
      "properties": {
        "version": {
          "const": "scenario_survey_v2.2"
        },
        "mode": {
          "const": "plan_only"
        },
        "target_id": {
          "type": "string"
        },
        "target_ip": {
          "type": "string"
        },
        "planning_scope": {
          "type": "array",
          "items": {
            "enum": [
              "endpoint",
              "web"
            ]
          }
        },
        "max_steps": {
          "type": "integer"
        },
        "execution_authorized": {
          "const": false
        },
        "cleanup_required": {
          "const": true
        },
        "rollback_required": {
          "const": true
        }
      }
    },
    "target_profile": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Id"
        },
        "target_ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Ip"
        },
        "domains": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Domains",
          "type": "object"
        },
        "summary": {
          "additionalProperties": true,
          "title": "Summary",
          "type": "object"
        },
        "inventory_refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Inventory Refs",
          "type": "array"
        },
        "interpretation": {
          "additionalProperties": true,
          "title": "Interpretation",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "target_id",
        "target_ip",
        "domains",
        "summary",
        "inventory_refs",
        "interpretation"
      ],
      "title": "Profile",
      "type": "object"
    },
    "survey_context": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "survey_run_id": {
          "title": "Survey Run Id",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Id"
        },
        "target_ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Ip"
        },
        "scope": {
          "items": {
            "type": "string"
          },
          "title": "Scope",
          "type": "array"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Started At"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finished At"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "title": "Observations",
          "type": "array"
        },
        "gaps": {
          "items": {
            "$ref": "#/$defs/Gap"
          },
          "title": "Gaps",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "coverage": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Coverage",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "survey_run_id",
        "target_id",
        "target_ip",
        "scope",
        "started_at",
        "finished_at",
        "status",
        "observations",
        "gaps",
        "conflicts",
        "coverage"
      ],
      "title": "Context",
      "type": "object"
    },
    "evidence_quality": {
      "type": "object"
    }
  }
}
