# Tao key trong Google AI Studio, chon project Free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
E5_MODEL=intfloat/multilingual-e5-small
# Cac lenh run/resume can xac nhan project Free tier tren AI Studio.
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_TIMEOUT_SECONDS=300
# Applies only to request parsing with gemini-3.8-flash. Plan thinking is unchanged.
GEMINI_PARSE_THINKING_LEVEL=low
GEMINI_PROGRESS=0
# Application retries only HTTP 500/502/503/504; SDK stays at one attempt.
GEMINI_MAX_ATTEMPTS=2
GEMINI_RETRY_DELAY_SECONDS=5
